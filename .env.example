# Login credentials (the only gate; changing APP_PASSWORD or APP_SECRET signs everyone out)
APP_USERNAME=your_login_email
APP_PASSWORD=your_login_password
APP_SECRET=generate_a_random_hex_string


# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# Service role key (same value as in Supabase dashboard — either name works)
SUPABASE_SERVICE_KEY=your_supabase_service_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key
RESEND_API_KEY=your_resend_api_key

# After pulling workspace changes, run scripts/supabase-workspace-prefill.sql in the SQL editor once.

# -----------------------------------------------------------------------------
# Email sending
# Tarun workspace: Gmail SMTP. Enable 2-Step Verification, then create an App
# Password (Google Account → Security → App passwords).
# Pallavi workspace: Hostinger SMTP (smtp.hostinger.com:465) with the mailbox
# password from Hostinger hPanel → Emails. Not your hPanel login.
# -----------------------------------------------------------------------------

# Tarun (password may include spaces as Google shows it)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME_TARUN=Tarun Kumar

# Pallavi: sends from hello@tarun.codes, Cc ashwini@lkss.in (recipients live in lib/invoice-defaults.js)
HOSTINGER_EMAIL_USER=hello@tarun.codes
HOSTINGER_EMAIL_PASSWORD=your_hostinger_mailbox_password
EMAIL_FROM_NAME_PALLAVI=Tarun Kumar
# Optional: override the sender shown in the UI / on the invoice (defaults to hello@tarun.codes)
# NEXT_PUBLIC_SENDER_EMAIL_PALLAVI=hello@tarun.codes

# Shown read-only in the Tarun compose UI (should match GMAIL_USER)
NEXT_PUBLIC_SENDER_EMAIL=your_sender@gmail.com
NEXT_PUBLIC_RECIPIENTS=recipient1@example.com,recipient2@example.com
