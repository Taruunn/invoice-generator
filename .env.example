# Login credentials (first gate — lands on workspace picker)
APP_USERNAME=your_login_email
APP_PASSWORD=your_login_password
APP_SECRET=generate_a_random_hex_string

# Tarun workspace (second gate — required to open Tarun tab)
TARUN_WORKSPACE_USERNAME=tarun_workspace_user
TARUN_WORKSPACE_PASSWORD=tarun_workspace_password

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# Service role key (same value as in Supabase dashboard — either name works)
SUPABASE_SERVICE_KEY=your_supabase_service_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key
RESEND_API_KEY=your_resend_api_key

# After pulling workspace changes, run scripts/supabase-workspace-prefill.sql in the SQL editor once.

# -----------------------------------------------------------------------------
# Email sending (Gmail SMTP — same flow for Tarun and Vagmi)
# Use the Google account that should appear as the sender. Enable 2-Step
# Verification, then create an App Password (Google Account → Security).
# Workspace (@yourdomain.com) mailboxes work the same way if hosted on Google.
# Vagmi walkthrough: docs/vagmi-email-setup.md
# -----------------------------------------------------------------------------

# Tarun — invoices + Email button in Tarun workspace (password may include spaces as Google shows it)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME_TARUN=Tarun Kumar

# Vagmi — invoices + Email button in Vagmi workspace (her own Google login + app password)
GMAIL_USER_VAGMI=vagmi@gmail.com
GMAIL_APP_PASSWORD_VAGMI=vagmi_app_password_16_chars
EMAIL_FROM_NAME_VAGMI=Vagmi

# Shown read-only in compose UI (should match the mailbox above per workspace)
NEXT_PUBLIC_SENDER_EMAIL=your_sender@gmail.com
NEXT_PUBLIC_RECIPIENTS=recipient1@example.com,recipient2@example.com

NEXT_PUBLIC_SENDER_EMAIL_VAGMI=vagmi@gmail.com
# Optional; if empty, Vagmi’s Email modal uses NEXT_PUBLIC_RECIPIENTS (same as Tarun)
NEXT_PUBLIC_RECIPIENTS_VAGMI=
